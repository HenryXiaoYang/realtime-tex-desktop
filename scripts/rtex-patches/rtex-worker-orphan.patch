diff --git a/tex/rtex-serve.lua b/tex/rtex-serve.lua
index 1ddc1c6..2d69d6f 100644
--- a/tex/rtex-serve.lua
+++ b/tex/rtex-serve.lua
@@ -447,7 +447,12 @@ function S.init(boxnum, countnum, cctnum)
   end
   local path = os.getenv("RTEX_RESP")
   local err
+  -- Unix: a write-only open of the FIFO waits for a reader, forever when the host died during the
+  -- preamble. Held open read-write meanwhile, it returns at once, and a host already gone shows
+  -- as SIGPIPE on the ready frame or end of file on stdin.
+  local hold = not (req_path and req_path ~= "") and io.open(path, "r+b")
   resp, err = io.open(path, "wb")
+  if hold then hold:close() end
   assert(resp, "cannot open response channel " .. tostring(path) .. ": " .. tostring(err))
   resp:setvbuf("full", 1 << 16)
   luatexbase.add_to_callback("show_error_hook", S.on_error, "rtex-serve")
